# AI (required) - server-only secret, NEVER exposed to the browser.
# Get a free key at https://console.groq.com/keys and put it in your own .env file
# (or in your hosting provider's server environment variables, e.g. Vercel > Settings > Environment Variables).
# Do NOT prefix it with VITE_ - VITE_ variables get bundled into client code and become public.
GENERATIVE_KEY=gsk_your-secret-key-here

# GitHub token (optional) - raises GitHub API rate limits for repo scanning. Server-only, no VITE_ prefix.
# GITHUB_TOKEN=ghp_your-token-here

# AI model override (optional, defaults to Groq's openai/gpt-oss-120b)
# AI_MODEL=openai/gpt-oss-120b

# OpenAI-compatible provider endpoint (optional).
# Leave unset for Groq. For higher-quality output, point this at OpenAI,
# OpenRouter, or another compatible provider and set AI_MODEL accordingly.
# AI_BASE_URL=https://api.openai.com/v1
# AI_TPM_LIMIT=24000

# Rate limits
# Per-user generations per rolling 15-hour sliding window (default 8).
USER_RATE_LIMIT=8
# USER_DAILY_LIMIT=8  # legacy alias; USER_RATE_LIMIT takes precedence.
# App-wide daily generation cap across ALL users (default 1000) - global circuit breaker.
# GLOBAL_DAILY_CAP=1000

# App Check (recommended in production).
# Site key for ReCaptcha v3 from Firebase Console > App Check > Apps. Client-side.
# VITE_RECAPTCHA_SITE_KEY=
# Enforce App Check server-side on the generation endpoint. The Firestore rules
# always require app.check() regardless of this flag. Set to "true" in prod.
# ENFORCE_APP_CHECK=false

# Durable rate limiting (recommended in production).
# Paste the FULL Firebase service-account JSON on one line so the per-user + global
# quotas survive restarts and are shared across all server instances:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# If Vercel formatting causes JSON parsing issues, base64-encode the same JSON
# and use FIREBASE_SERVICE_ACCOUNT_JSON_BASE64 instead.
# Optional compatibility flag. The app always falls back to in-memory quota if
# Firebase Admin is unavailable; Firestore is used automatically when configured.
# REQUIRE_DURABLE_RATE_LIMIT=false

# Extra allowed origins for server-function calls (comma-separated hosts)
# ALLOWED_ORIGINS=

# Salt for pseudonymized abuse logs (any random string)
ABUSE_LOG_SALT=change-me-to-random

# Firebase config (required for sign-in - copy values from Firebase Console > Project Settings).
# Note: Firebase web keys are public identifiers by design (locked down via security rules
# and authorized domains), so the VITE_ prefix is expected here - these are NOT secrets like GENERATIVE_KEY.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
