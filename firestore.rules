rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (requires firebase.json wiring or Firebase Console -> Firestore -> Rules)
service cloud.firestore {
  match /databases/{database}/documents {

    // Usage quota documents: a signed-in user may READ only their own doc.
    // All client writes are denied - the backend (Firebase Admin SDK)
    // bypasses these rules and is the sole writer of usage docs.
    match /usage/{uid} {
      allow get, list: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
